# MySQL Database Configuration
# For Local MySQL:
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ridesync_db
MYSQL_SSL=false

